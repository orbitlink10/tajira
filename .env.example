APP_NAME=Tajira
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://www.example.com
APP_TIMEZONE=Africa/Nairobi
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_KE

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tajira
DB_USERNAME=tajira
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="orders@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Replace every placeholder below with approved business facts before launch.
TAJIRA_DOMAIN=https://www.example.com
TAJIRA_BUSINESS_NAME="Tajira"
TAJIRA_LEGAL_NAME=""
TAJIRA_PHONE="+254700000000"
TAJIRA_WHATSAPP="254700000000"
TAJIRA_EMAIL="sales@example.com"
TAJIRA_SUPPORT_EMAIL="support@example.com"
TAJIRA_ADDRESS_LINE=""
TAJIRA_CITY="Nairobi"
TAJIRA_COUNTRY="Kenya"
TAJIRA_POSTAL_CODE=""
TAJIRA_TAX_PIN=""
TAJIRA_TAX_RATE_PERCENT=16
TAJIRA_TAX_INCLUSIVE=true
TAJIRA_CURRENCY=KES
TAJIRA_MAP_URL=""
TAJIRA_FACEBOOK_URL=""
TAJIRA_INSTAGRAM_URL=""
TAJIRA_LINKEDIN_URL=""
TAJIRA_X_URL=""
TAJIRA_DELIVERY_NOTICE="Delivery options and charges are confirmed at checkout."
TAJIRA_RETURNS_SUMMARY="Returns are accepted within the period stated in the returns policy, subject to condition checks."
TAJIRA_WARRANTY_SUMMARY="Warranty cover is determined by the manufacturer and the approved Tajira warranty policy."
TAJIRA_FREE_DELIVERY_THRESHOLD=0
TAJIRA_PICKUP_ENABLED=true
TAJIRA_PICKUP_INSTRUCTIONS="Pickup location and collection times are confirmed by our team after your order is accepted."
TAJIRA_STOCK_RESERVATION_MINUTES=30
TAJIRA_ORDER_PREFIX=TJ

MPESA_ENABLED=false
MPESA_ENV=production
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL="${APP_URL}/payments/mpesa/callback"
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_TIMEOUT_SECONDS=30
# Optional comma-separated callback source IP allowlist. Verify Safaricom ranges before enabling.
MPESA_CALLBACK_IPS=

BANK_TRANSFER_ENABLED=true
BANK_NAME=""
BANK_ACCOUNT_NAME=""
BANK_ACCOUNT_NUMBER=""
BANK_BRANCH=""

CARD_PAYMENTS_ENABLED=false
CARD_PROVIDER=
CARD_PUBLIC_KEY=
CARD_SECRET_KEY=

GA4_MEASUREMENT_ID=
GSC_VERIFICATION=
MERCHANT_CENTER_ENABLED=false
MERCHANT_FEED_TOKEN=
META_PIXEL_ID=
ANALYTICS_REQUIRE_CONSENT=true

IMPORT_ENABLED=true
IMPORT_SOURCE_BASE=https://ctcsolutions.co.ke
IMPORT_RATE_LIMIT_PER_MINUTE=20
IMPORT_MAX_BYTES=5000000
IMPORT_USER_AGENT="TajiraCatalogueBot/1.0 (+contact: set TAJIRA_EMAIL)"

# Staging and indexing controls (production values below)
TAJIRA_GLOBAL_NOINDEX=false
TAJIRA_STAGING_PROTECT=false
TAJIRA_STAGING_USER=
TAJIRA_STAGING_PASSWORD=
TAJIRA_REQUIRE_ADMIN_MFA=true
TAJIRA_LOCAL_BUSINESS=false
TAJIRA_RETURNS_DAYS=0
TAJIRA_FREE_DELIVERY_THRESHOLD=0

# Demo/local seeding only. Never enable demo users in production.
TAJIRA_SEED_DEMO_USERS=false
TAJIRA_SEED_ADMIN_EMAIL=admin@example.com
TAJIRA_SEED_ADMIN_PASSWORD=

# Catalogue import allowlist (comma-separated hosts)
IMPORT_ALLOWED_HOSTS=ctcsolutions.co.ke,www.ctcsolutions.co.ke