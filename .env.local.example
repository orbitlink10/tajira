APP_NAME=Tajira
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Africa/Nairobi
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_KE

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tajira
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="orders@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Replace these placeholders with approved local/development facts.
TAJIRA_DOMAIN=http://127.0.0.1:8000
TAJIRA_BUSINESS_NAME="Tajira"
TAJIRA_LEGAL_NAME=""
TAJIRA_PHONE="+254700000000"
TAJIRA_WHATSAPP="254700000000"
TAJIRA_EMAIL="sales@example.com"
TAJIRA_SUPPORT_EMAIL="support@example.com"
TAJIRA_ADDRESS_LINE=""
TAJIRA_CITY="Nairobi"
TAJIRA_COUNTRY="Kenya"
TAJIRA_POSTAL_CODE=""
TAJIRA_TAX_PIN=""
TAJIRA_TAX_RATE_PERCENT=16
TAJIRA_TAX_INCLUSIVE=true
TAJIRA_CURRENCY=KES
TAJIRA_MAP_URL=""
TAJIRA_FACEBOOK_URL=""
TAJIRA_INSTAGRAM_URL=""
TAJIRA_LINKEDIN_URL=""
TAJIRA_X_URL=""
TAJIRA_DELIVERY_NOTICE="Delivery options and charges are confirmed at checkout."
TAJIRA_RETURNS_SUMMARY="Returns are accepted within the period stated in the returns policy, subject to condition checks."
TAJIRA_WARRANTY_SUMMARY="Warranty cover is determined by the manufacturer and the approved Tajira warranty policy."
TAJIRA_FREE_DELIVERY_THRESHOLD=0
TAJIRA_PICKUP_ENABLED=true
TAJIRA_PICKUP_INSTRUCTIONS="Pickup location and collection times are confirmed by our team after your order is accepted."
TAJIRA_STOCK_RESERVATION_MINUTES=30
TAJIRA_ORDER_PREFIX=TJ

MPESA_ENABLED=false
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL="${APP_URL}/payments/mpesa/callback"
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_TIMEOUT_SECONDS=30
MPESA_CALLBACK_IPS=

BANK_TRANSFER_ENABLED=true
BANK_NAME=""
BANK_ACCOUNT_NAME=""
BANK_ACCOUNT_NUMBER=""
BANK_BRANCH=""

CARD_PAYMENTS_ENABLED=false
CARD_PROVIDER=
CARD_PUBLIC_KEY=
CARD_SECRET_KEY=

GA4_MEASUREMENT_ID=
GSC_VERIFICATION=
MERCHANT_CENTER_ENABLED=false
MERCHANT_FEED_TOKEN=
META_PIXEL_ID=
ANALYTICS_REQUIRE_CONSENT=true

IMPORT_ENABLED=true
IMPORT_SOURCE_BASE=https://ctcsolutions.co.ke
IMPORT_RATE_LIMIT_PER_MINUTE=20
IMPORT_MAX_BYTES=5000000
IMPORT_USER_AGENT="TajiraCatalogueBot/1.0 (+contact: set TAJIRA_EMAIL)"
IMPORT_ALLOWED_HOSTS=ctcsolutions.co.ke,www.ctcsolutions.co.ke

TAJIRA_GLOBAL_NOINDEX=false
TAJIRA_STAGING_PROTECT=false
TAJIRA_STAGING_USER=
TAJIRA_STAGING_PASSWORD=
TAJIRA_REQUIRE_ADMIN_MFA=false
TAJIRA_LOCAL_BUSINESS=false
TAJIRA_RETURNS_DAYS=0

# Local demo seeding. Do not use these defaults on a shared/public server.
TAJIRA_SEED_DEMO_USERS=true
TAJIRA_SEED_ADMIN_EMAIL=admin@demo.com
TAJIRA_SEED_ADMIN_PASSWORD=admin123
